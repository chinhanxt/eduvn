# Token để lõi EDUVN / OpenMAIC / DeepTutor gọi cổng (ít nhất 24 ký tự, tạo bằng: openssl rand -hex 24)
GATEWAY_TOKEN=thay-bang-chuoi-ngau-nhien-dai
HOST=127.0.0.1
PORT=4340
# Số tiến trình agy acp chạy sẵn (mỗi tiến trình chạy được nhiều phiên song song)
AGY_PROCESSES=2
# Proxy xoay tài khoản riêng của cổng (không dùng 8899 của phiên agyxt tay)
AGY_PROXY_PORT=8900
# Cổng tự bật/tắt proxy trên AGY_PROXY_PORT (1 = có; chỉ tắt nếu chính cổng đã bật)
AGY_MANAGE_PROXY=1
MAX_CONCURRENCY=6
# Số chỗ dành riêng cho chat (việc theo lô không chiếm)
CHAT_RESERVED=1
# Chat chờ chỗ quá lâu (ms) thì trả 503 "đang bận"
CHAT_MAX_WAIT_MS=30000
# Thư mục tạm của agy (phiên, cwd); nên ở ngoài repo
WORK_DIR=/var/tmp/eduvn-gateway
# Hội thoại để rảnh quá thời gian này (ms) thì bỏ phiên
SESSION_IDLE_MS=900000
# Số hội thoại giữ tối đa; vượt thì bỏ hội thoại rảnh lâu nhất
MAX_CONVERSATIONS=300
# Thay mới tiến trình agy sau ngần này phiên. Đo thật 60 phiên: RSS 164 -> 318 MB, fd đã xoá nhưng còn mở ~0,3-0,8/phiên, -wal ~1,3 MB/phiên giữ đĩa đến khi tiến trình thoát
AGY_RECYCLE_SESSIONS=150
# Mức log: fatal|error|warn|info|debug (không ghi nội dung yêu cầu)
LOG_LEVEL=info
# Dự phòng khi tài khoản agy bị khoá: điền khoá API Anthropic (để trống = tắt)
ANTHROPIC_API_KEY=
