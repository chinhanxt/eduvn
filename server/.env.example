DATABASE_URL=postgres://eduvn:eduvn-dev@127.0.0.1:5442/eduvn
OIDC_ISSUER=http://localhost:8180/realms/eduvn
OIDC_JWKS_URL=http://localhost:8180/realms/eduvn/protocol/openid-connect/certs
OIDC_AUDIENCE=eduvn-api
PUBLIC_URL=http://localhost:4310
DOWNLOAD_SECRET=dev-only-change-me-dev-only-change-me
STUDENT_SECRET=dev-only-student-secret-change-me-0123
HOST=127.0.0.1
PORT=4310

# Cổng AI (gateway/, cùng GATEWAY_TOKEN với gateway/.env). Để trống token = tắt AI phía lõi.
GATEWAY_URL=http://127.0.0.1:4340
GATEWAY_TOKEN=

# Bài giảng AI (OpenMAIC): thư mục lưu âm thanh lời giảng + video xuất; giọng đọc VieNeu (vieneu|off); Chrome để dựng MP4.
DATA_DIR=./data
TTS_PROVIDER=vieneu
# VIENEU_CMD=vieneu-say
# VIENEU_REF=/home/<bạn>/video-studio/voices/Giọng dạy.wav   (hoặc VIENEU_VOICE=<giọng có sẵn>)
# Khoá việc nặng dùng chung (bọc đọc giọng + dựng hoạt hình toán): HEAVY_BIN=/home/<bạn>/video-studio/bin/heavy
# Hoạt hình toán: MANIM_HOME=/home/<bạn>/Apps/manim  TINYTEX_BIN=/home/<bạn>/Apps/tinytex/bin/x86_64-linux
CHROME_PATH=/usr/bin/google-chrome
# Cổng AI cũ chưa có task slide_tuong_tac: ánh xạ tạm sang task có sẵn (cảnh interactive trả HTML nên không dùng task ép JSON), vd:
# AI_TASK_OVERRIDES={"slide_tuong_tac":"soan_giao_an"}
# Nhà cung cấp phụ (G1, /gv/cai-dat/nha-cung-cap). Mặc định tự chạy trên máy chủ; model lấy từ cache HuggingFace có sẵn, không tải mới.
# OMNIVOICE=on   OMNIVOICE_REF=/home/<bạn>/video-studio/voices/Giọng tâm sự.wav   (lời mẫu: file .txt cùng tên)
# ASR_PROVIDER=faster-whisper   WHISPER_MODEL=small   WHISPER_DEVICE=auto   (auto: GPU int8, thiếu VRAM → CPU)
# PYTHON_BIN=python3   SOFFICE_BIN=soffice   HF_HOME=/home/<bạn>/.cache/huggingface
