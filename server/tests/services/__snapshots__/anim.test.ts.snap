.st.end .tx{border:2px solid var(--line);border-left:6px solid #6F42C1;border-radius:4px 12px 12px 4px;padding:14px 30px 18px;background:var(--surface);box-shadow:0 1px 2px rgb(28 27 26 / .04), 0 4px 14px rgb(28 27 26 / .05)}
.st.end .ecap{display:block;font-family:var(--ui);font-size:36px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#6F42C1;margin-bottom:4px;line-height:1.3}
.st.end .bd{margin-top:74px}
