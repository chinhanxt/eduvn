<link rel="stylesheet" href="assets/katex/katex.min.css">
<style>
@font-face{font-family:"Noto Sans";src:local("Noto Sans"),local("NotoSans-Regular")}
*{margin:0;padding:0;box-sizing:border-box}
html,body{width:1280px;height:720px;overflow:hidden;background:#10142b}
#root{position:absolute;inset:0;background:#10142b;font-family:"Noto Sans","DejaVu Sans",sans-serif;color:#f3f5ff}
#tt{position:absolute;left:64px;right:64px;top:30px;font-size:38px;font-weight:700;color:#ffd166}
.body{position:absolute;left:64px;right:64px;top:100px;bottom:48px;display:flex;flex-direction:column;justify-content:center;gap:18px}
.line{font-size:36px;line-height:1.35;padding:12px 22px;border-left:6px solid #4f6bed;border-radius:6px;background:rgba(79,107,237,.12)}
.flow{flex-direction:row;align-items:center;justify-content:center;gap:0}
.box{width:180px;min-height:170px;padding:18px 14px;border-radius:14px;background:#1c2350;border:3px solid #4f6bed;text-align:center;display:flex;flex-direction:column;justify-content:center;gap:10px}
.box b{font-size:30px;color:#ffd166}.box span{font-size:22px;color:#c9d0ff}
.arr{width:50px;height:40px;display:flex;align-items:center;justify-content:center}
.row{display:grid;grid-template-columns:repeat(2,1fr);gap:0;font-size:30px;border-radius:8px;overflow:hidden}
.row div{padding:14px 18px;border-bottom:1px solid #2c3470}
.hd div{background:#4f6bed;font-weight:700;color:#fff}
.rw div{background:rgba(79,107,237,.10)}
.katex{font-size:1.05em}
.fc{position:absolute;perspective:1200px}.fin{position:absolute;inset:0;transform-style:preserve-3d}.ff,.fb{position:absolute;inset:0;backface-visibility:hidden;border-radius:18px;display:flex;align-items:center;justify-content:center;text-align:center;padding:28px;font-size:34px;line-height:1.3;font-weight:700}.ff{background:#1c2350;border:4px solid #56B4E9}.fb{background:#14392f;border:4px solid #009E73;transform:rotateY(180deg);font-weight:400;font-size:30px}</style></head><body>
<div id="root" data-composition-id="main" data-start="0" data-duration="10" data-width="1280" data-height="720">
<h1 id="tt" class="clip" data-start="0" data-duration="10" data-track-index="0">Tiêu đề &lt;b&gt;x&lt;/b&gt;</h1>
<div id="c0" class="fc clip" style="left:108px;top:170px;width:520px;height:300px" data-start="0.4" data-duration="9.6" data-track-index="1"><div id="in0" class="fin"><div class="ff">Định luật Ôm là gì?</div><div class="fb">I = U / R</div></div></div>
<div id="c1" class="fc clip" style="left:652px;top:170px;width:520px;height:300px" data-start="4.8" data-duration="5.2" data-track-index="2"><div id="in1" class="fin"><div class="ff">Đơn vị của điện trở?</div><div class="fb">Ôm (Ω)</div></div></div>
</div>
<script>
const tl = gsap.timeline({ paused: true });
tl.fromTo("#c0", { opacity: 0, y: 30 }, { opacity: 1, x: 0, y: 0, scale: 1, duration: 0.45, ease: "power3.out" }, 0.4);
tl.fromTo("#in0", { rotateY: 0 }, { rotateY: 180, duration: 0.7, ease: "power2.inOut" }, 2.6);
tl.fromTo("#c1", { opacity: 0, y: 30 }, { opacity: 1, x: 0, y: 0, scale: 1, duration: 0.45, ease: "power3.out" }, 4.8);
tl.fromTo("#in1", { rotateY: 0 }, { rotateY: 180, duration: 0.7, ease: "power2.inOut" }, 7);

window.__timelines["main"] = tl;
tl.seek(0);
</script></body></html>
"
`;

