#root{position:absolute;inset:0;background:#10142b;font-family:"Noto Sans","DejaVu Sans",sans-serif;color:#f3f5ff}
#tt{position:absolute;left:64px;right:64px;top:30px;font-size:38px;font-weight:700;color:#ffd166}
.body{position:absolute;left:64px;right:64px;top:100px;bottom:48px;display:flex;flex-direction:column;justify-content:center;gap:18px}
.line{font-size:36px;line-height:1.35;padding:12px 22px;border-left:6px solid #4f6bed;border-radius:6px;background:rgba(79,107,237,.12)}
.flow{flex-direction:row;align-items:center;justify-content:center;gap:0}
.box{width:180px;min-height:170px;padding:18px 14px;border-radius:14px;background:#1c2350;border:3px solid #4f6bed;text-align:center;display:flex;flex-direction:column;justify-content:center;gap:10px}
.box b{font-size:30px;color:#ffd166}.box span{font-size:22px;color:#c9d0ff}
.arr{width:50px;height:40px;display:flex;align-items:center;justify-content:center}
.row{display:grid;grid-template-columns:repeat(2,1fr);gap:0;font-size:30px;border-radius:8px;overflow:hidden}
.row div{padding:14px 18px;border-bottom:1px solid #2c3470}
.hd div{background:#4f6bed;font-weight:700;color:#fff}
.rw div{background:rgba(79,107,237,.10)}
.katex{font-size:1.05em}
.nd{position:absolute;text-align:center;font-size:22px;padding:8px 6px;border-radius:12px;background:#1c2350;border:3px solid #56B4E9}.root{border-color:#ffd166;font-weight:700}.leaf{border-color:#009E73;background:#14392f;font-size:20px}.leaf small{font-size:22px;color:#F0E442;font-weight:700}.pl2{position:absolute;text-align:center;font-size:22px;color:#F0E442;font-weight:700}.ln2{position:absolute}</style></head><body>
