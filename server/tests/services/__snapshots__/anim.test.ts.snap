<div id="s1" class="st end"><div id="d1" class="bd">2</div><div class="tx" id="x1"><span class="ecap">Kết luận</span><span id="t1"><span class="w">&lt;script&gt;alert(1)&lt;/script&gt;</span> <span class="w">Vậy</span> <span class="w">x</span> <span class="w">=</span> <span class="w">±2</span></span></div></div></div>
