.card{position:absolute;background:var(--surface);border:2px solid var(--line);border-left:6px solid var(--accent);border-radius:4px 12px 12px 4px;padding:22px 30px 24px;box-shadow:0 1px 2px rgb(28 27 26 / .04), 0 4px 14px rgb(28 27 26 / .05)}
.card h3{font-size:40px;font-weight:600;color:var(--ink);line-height:1.25;margin-bottom:8px}
.card p,.card .p{font-size:38px;line-height:1.4;color:var(--ink2)}
.katex{font-size:1.06em}

#lst{position:absolute;left:120px;top:273px;width:1680px;display:flex;flex-direction:column;gap:23px}
.st{position:relative;display:flex;gap:40px;align-items:flex-start;font-family:var(--read);font-size:52px;line-height:1.42;color:var(--ink)}
.st .bd{flex:none;position:relative;z-index:2;display:grid;place-items:center;width:56px;height:56px;margin-top:9px;border-radius:50%;font-family:var(--ui);font-size:28px;font-weight:700;border:3px solid var(--line);background:var(--bg);color:var(--ink3)}
