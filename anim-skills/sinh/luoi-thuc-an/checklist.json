{
  "requires": [
    { "selector": "svg#foodweb-svg", "min": 1 },
    { "selector": ".pyramid-bar", "min": 3, "max": 5 },
    { "selector": ".ek-arrow", "min": 3, "max": 12 }
  ],
  "motion": [
    { "kind": "staysInFrame", "selector": ".ek-label" },
    { "kind": "keepsMoving", "maxStaticSec": 4 }
